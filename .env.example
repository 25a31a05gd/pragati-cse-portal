# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Frontend (Vercel): Set VITE_API_BASE_URL to your Render backend URL when frontend and backend are hosted separately.
# Leave unset when frontend and backend share the same origin.
VITE_API_BASE_URL="https://your-backend-service.onrender.com"

# Backend CORS (Render): Comma-separated allowed frontend origins (Vercel URL / custom domain).
# Wildcard subdomains such as https://*.vercel.app are also supported when explicitly listed.
CORS_ORIGINS="https://your-frontend.vercel.app"
FRONTEND_URL="https://your-frontend.vercel.app"

# Backend-only Supabase & PostgreSQL secrets (never expose to frontend)
# On Vercel Serverless, prefer the Supabase Transaction Pooler (port 6543, ?pgbouncer=true, *.pooler.supabase.com) to avoid connection exhaustion.
# On persistent hosts like Render, use the Session Pooler (port 5432) or Transaction Pooler (port 6543).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
INITIAL_ADMIN_EMAIL="admin@institution.edu"

# Optional backend coding-profile verification settings
CODING_VERIFY_HMAC_SECRET=""
GITHUB_TOKEN=""
